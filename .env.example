# Bot token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Comma-separated list of admin Telegram IDs (no spaces)
ADMIN_IDS=123456789,987654321

# Public admin username (without @) shown to users as contact person
ADMIN_USERNAME=admin_username

# Database URL. SQLite for dev; switch to PostgreSQL for prod:
# postgresql+asyncpg://user:pass@localhost:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///bot_data.db

# Scheduler / behaviour settings
REMINDER_INTERVAL_MIN=10
REMINDER_DELAY_MIN=30
DROP_OFF_HOURS=24
DAILY_REPORT_HOUR=21
DAILY_REPORT_MIN=0

# Flood control
FLOOD_LIMIT=10
FLOOD_WINDOW_SEC=60
FLOOD_BAN_MIN=5
